    { "key": "||", "letter": "॥", "type": "symbol", "group": "signs", "order": 6, "note": "double danda" },

    { "key": "^",  "letter": "\u200C", "type": "control", "action": "zwnj",  "group": "controls", "order": 1, "note": "zero-width non-joiner: keeps the visible pollu instead of forming a conjunct" },
    { "key": "_",  "letter": "",       "type": "control", "action": "break", "group": "controls", "order": 2, "note": "break key: splits a key sequence that would otherwise merge; outputs nothing" },
    { "key": "__", "letter": "",       "type": "control", "action": "close", "group": "controls", "order": 3, "note": "syllable close: writes the pending pollu so that a following vowel stays independent (k__a gives క్అ); needed only for unusual text" },

