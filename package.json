{
  "name": "palaka",
  "version": "0.1.0",
  "private": true,
  "description": "పలక! (Palaka): a Telugu writing slate. Type Palaka-HK roman, get exact Telugu Unicode.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "validate:scheme": "tsx scripts/validate-scheme.ts",
    "docs:scheme": "tsx scripts/gen-scheme-doc.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "npm run validate:scheme && tsc --noEmit && vite build",
    "preview": "vite preview",
    "check": "npm run lint && npm run typecheck && npm test && npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.2",
    "eslint": "^10.11.0",
    "fast-check": "^4.10.2",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
